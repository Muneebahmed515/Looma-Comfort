# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.
# Without the Supabase values the site runs in demo mode (bundled sample catalogue, admin is read-only).

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…) or legacy "service_role" key. Server only: never expose it.
# Needed for: contact form, newsletter, reviews, WhatsApp click counting, inviting admins.
SUPABASE_SECRET_KEY=

# Long random strings (e.g. run: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
# REVALIDATE_SECRET must match the "revalidate_secret" saved in Supabase Vault (see README).
REVALIDATE_SECRET=
# Vercel sends this to the daily keep-alive cron job.
CRON_SECRET=

# Cloudflare Turnstile (free spam protection for forms). Optional but recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
