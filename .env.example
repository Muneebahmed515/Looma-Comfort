# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.
# Without DATABASE_URL the site runs in demo mode (bundled sample catalogue, admin is read-only).

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon → your project → Connect → connection string (the "pooled" one, with sslmode=require).
# If you connect Neon from Vercel's Storage tab, Vercel adds DATABASE_URL for you.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Signs the admin sign-in cookie. A long random string (e.g. run: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())")
AUTH_SECRET=

# Vercel Blob (image uploads from the admin). Vercel → Storage → Create → Blob, connect it to the project,
# and Vercel adds this for you. For local uploads, copy the token from the store's settings here.
BLOB_READ_WRITE_TOKEN=

# Long random strings, same command as above.
# REVALIDATE_SECRET protects POST /api/revalidate (optional external scheduler).
REVALIDATE_SECRET=
# Vercel sends this to the daily cron job.
CRON_SECRET=

# Cloudflare Turnstile (free spam protection for forms). Optional but recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
